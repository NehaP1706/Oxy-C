        "description": "Tests that 'hop' with no arguments and 'hop ~' both change the CWD to the home directory.",
        "cmds": [
            {
                "expect_exit": false,
                "cmd": "hop test/folder1",
                "sequential_outputs": [],
                "nonsequential_outputs": [],
                "ignore_output": true,
                "cwd_after": "~/test/folder1"
