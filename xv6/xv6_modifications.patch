From ad0d564d1cec219f6c360b5afd8c0c71d5020aeb Mon Sep 17 00:00:00 2001
From: Layla1706 <nehaprabhup17@gmail.com>
Date: Sat, 6 Sep 2025 15:09:45 +0530
Subject: [PATCH 1/8] Readcount updated.

---
 kernel/readcount.c | 13 +++++++++++++
 kernel/readcount.h | 11 +++++++++++
 user/readcount.c   | 25 +++++++++++++++++++++++++
 3 files changed, 49 insertions(+)
 create mode 100644 kernel/readcount.c
 create mode 100644 kernel/readcount.h
 create mode 100644 user/readcount.c

diff --git a/kernel/readcount.c b/kernel/readcount.c
new file mode 100644
index 0000000..e94cee1
--- /dev/null
+++ b/kernel/readcount.c
@@ -0,0 +1,13 @@
+// in kernel/readcount.c (create)
+#include "types.h"
+#include "defs.h"
+#include "readcount.h"
+
+uint64 global_read_bytes = 0;
+
+void
+add_read_bytes(unsigned int n)
+{
+  // natural wrap-around due to unsigned long long overflow
+  global_read_bytes += (uint64)n;
+}
diff --git a/kernel/readcount.h b/kernel/readcount.h
new file mode 100644
index 0000000..ad83d85
--- /dev/null
+++ b/kernel/readcount.h
@@ -0,0 +1,11 @@
+// in kernel/readcount.h (create)
+#ifndef READCOUNT_H
+#define READCOUNT_H
+
+#include "types.h"
+#include "defs.h"
+
+extern uint64 global_read_bytes; // wrap at overflow (natural for unsigned)
+void add_read_bytes(unsigned int n); // called by sys_read wrapper
+
+#endif
diff --git a/user/readcount.c b/user/readcount.c
new file mode 100644
index 0000000..af9a889
--- /dev/null
+++ b/user/readcount.c
@@ -0,0 +1,25 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int main(int argc, char *argv[]) {
+  if (argc < 2) {
+    printf("Usage: readcount <filename>\n");
+    exit(1);
+  }
+
+  printf("Initial: %d\n", getreadcount());
+
+  int fd = open(argv[1], 0);
+  if (fd < 0) {
+    printf("Cannot open %s\n", argv[1]);
+    exit(1);
+  }
+
+  char buf[100];
+  read(fd, buf, sizeof(buf));
+  close(fd);
+
+  printf("After: %d\n", getreadcount());
+  exit(0);
+}
-- 
