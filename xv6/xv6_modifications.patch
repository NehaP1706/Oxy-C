+    p->nice = 0;
+    p->weight = 1024;   // nice 0 -> weight 1024
+    p->vruntime = 0;
+    p->run_ticks = 0;
+    p->allowed_slice = 3; // default min slice; will be updated on scheduling
+  #endif
+
   // Allocate a trapframe page.
